<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.thorbis.field.document-action</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>thorbis</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ThorbisTapToPayEnabled</key>
	<false/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Thorbis uses Bluetooth to connect to supported card readers for in-person payments.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Thorbis uses your location to show your position on the schedule map and verify where in-person card payments occur.</string>
	<key>NSCameraUsageDescription</key>
	<string>Thorbis uses the camera to add job photos, such as before and after shots, to the job you are working on.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Thorbis uses Face ID so only you can leave customer mode after handing your device to a customer.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Inter.ttf</string>
		<string>GeistMono.ttf</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
